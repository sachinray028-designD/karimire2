# ============================================
# Karimi Real Estate — Environment Variables
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is gitignored.

# --- Supabase (required for the app) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- Scripts only (NOT used by the app) ---
# These are only needed for local scripts like scripts/import-blogs.mjs.
# The service_role key bypasses RLS — keep it secret, never commit it.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
